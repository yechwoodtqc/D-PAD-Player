<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Theme -->
    <ListPreference
        app:key="theme"
        app:title="@string/pref_theme_title"
        app:summary="%s"
        app:entries="@array/pref_theme_labels"
        app:entryValues="@array/pref_theme_values"
        app:defaultValue="system"
        app:useSimpleSummaryProvider="true"
        app:icon="@drawable/ic_settings_theme" />

    <!-- Accent color -->
    <ListPreference
        app:key="accent"
        app:title="@string/pref_accent_title"
        app:summary="%s"
        app:entries="@array/pref_accent_labels"
        app:entryValues="@array/pref_accent_values"
        app:defaultValue="blue"
        app:useSimpleSummaryProvider="true"
        app:icon="@drawable/ic_settings_theme" />

    <ListPreference
        app:key="display_size"
        app:title="@string/pref_display_size_title"
        app:summary="@string/pref_display_size_summary"
        app:entries="@array/pref_display_size_labels"
        app:entryValues="@array/pref_display_size_values"
        app:defaultValue="default"
        app:useSimpleSummaryProvider="true"
        app:icon="@drawable/ic_settings_theme" />

    <!-- Seek / skip duration -->
    <ListPreference
        app:key="seek_step"
        app:title="@string/pref_seek_title"
        app:summary="%s"
        app:entries="@array/pref_seek_labels"
        app:entryValues="@array/pref_seek_values"
        app:defaultValue="15000"
        app:useSimpleSummaryProvider="true"
        app:icon="@drawable/ic_settings_seek" />

    <SwitchPreferenceCompat
        app:key="keep_service_when_paused"
        app:title="@string/pref_keep_service_title"
        app:summary="@string/pref_keep_service_summary"
        app:defaultValue="true"
        app:icon="@drawable/ic_settings_seek" />

    <SwitchPreferenceCompat
        app:key="audio_focus_pause_on_duck"
        app:title="@string/pref_audio_focus_pause_on_duck_title"
        app:summary="@string/pref_audio_focus_pause_on_duck_summary"
        app:defaultValue="true"
        app:icon="@drawable/ic_settings_seek" />

    <!-- Sort order -->
    <ListPreference
        app:key="sort_order"
        app:title="@string/pref_sort_title"
        app:summary="%s"
        app:entries="@array/pref_sort_labels"
        app:entryValues="@array/pref_sort_values"
        app:defaultValue="title"
        app:useSimpleSummaryProvider="true"
        app:icon="@drawable/ic_settings_sort" />

    <!-- Show / hide the library tab strip. Hiding it swaps in a toolbar
         tab-picker button so the other sections stay reachable. -->
    <SwitchPreferenceCompat
        app:key="show_top_bar"
        app:title="@string/pref_show_top_bar_title"
        app:defaultValue="true"
        app:summary="@string/pref_show_top_bar_summary"
        app:icon="@drawable/ic_settings_theme" />

    <Preference
        app:key="export_logcat"
        app:title="@string/pref_export_logcat_title"
        app:summary="@string/pref_export_logcat_summary"
        app:icon="@drawable/ic_settings_seek" />

</PreferenceScreen>
